{
  // Type-check config for Playwright e2e tests and browser-driving scripts:
  // they run in Node but their page.evaluate() callbacks use DOM globals.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "lib": ["es2024", "dom", "dom.iterable"]
  },
  "include": [
    "tests/e2e/**/*.ts",
    "tests/guide/**/*.ts",
    "scripts/**/*.ts",
    "playwright.config.ts",
    "playwright.guide.config.ts"
  ],
  "exclude": ["node_modules", "dist", "web"]
}
