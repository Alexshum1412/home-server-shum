# Example settings for the family dashboard. Copy to .env and edit only what you need.
# .env is ignored by git. No secrets are required: sessions use random tokens stored as hashes.
# Save .env as UTF-8 WITHOUT BOM (Notepad: "UTF-8"). Do not create it with `> .env` in Windows
# PowerShell 5.1 — that writes UTF-16, which Node ignores and the scripts refuse.

# Network: keep 127.0.0.1 — remote access goes through Tailscale Serve (HTTPS, tailnet only).
HOST=127.0.0.1
PORT=8070

# Where users, sessions, the audit log and services.json live (outside the repository).
# Default on Windows: %SystemDrive%\FamilyServer\data\dashboard. Not AppData: processes started
# from packaged apps (e.g. the Claude desktop app) get AppData writes virtualized.
# DASHBOARD_DATA_DIR=C:\FamilyServer\data\dashboard

# 1 = demo mode: fake service states, clearly labelled «Демо» in the UI. Never use for the family.
DASHBOARD_DEMO=0

LOG_LEVEL=info
SERVICE_CHECK_INTERVAL_SEC=60
SERVICE_CHECK_TIMEOUT_MS=3000

# Volumes to watch for free space, separated by ';'
VOLUMES=C:\
LOW_SPACE_PERCENT=10

# Empty = Windows default printer
PRINTER_NAME=

TAILSCALE_EXE=C:\Program Files\Tailscale\tailscale.exe

# Addresses shown on the «Подключение» page
PUBLIC_URL=https://server-home.tail89d77e.ts.net
LAN_URL=

# auto = Secure cookie when the request came over HTTPS (Tailscale Serve); always | never
COOKIE_SECURE=auto

# Backups (scripts\backup.cmd). Targets separated by ';': an absolute folder (or \\host\share\folder)
# or label:<VolumeLabel>\<folder> — a folder on the volume with that label, whatever its drive letter.
# Default on Windows: main disk + the USB flash drive labelled "reserve".
# BACKUP_TARGETS=C:\FamilyServer\backups;label:reserve\FamilyServerBackups
# Complete snapshots kept in every target (1-365).
BACKUP_KEEP=14
# Git repository bundled into every snapshot. Default: this project folder.
# BACKUP_REPO_DIR=C:\Users\PC\Desktop\THE DASHBOARD
# Extra files stored under config\ (full paths, ';'). Empty = the project .env when it exists; none = off.
# BACKUP_EXTRA_FILES=none

# git.exe used for the code bundle. Default: git from PATH.
# GIT_EXE=C:\FamilyServer\tools\git\cmd\git.exe
